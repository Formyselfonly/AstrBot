FROM node:22-alpine AS build

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

ARG VITE_BRAND_NAME=大肥鱼鱼咖
ARG VITE_DOCS_URL=
ARG VITE_SUPPORT_EMAIL=support@example.com
ARG VITE_MIN_TOPUP_YUAN=1
ARG VITE_FEED_PLAN_YUAN_1=2
ARG VITE_FEED_PLAN_YUAN_2=5
ARG VITE_FEED_PLAN_YUAN_3=10
ARG VITE_FEED_PLAN_NAME_1=唔饿啦
ARG VITE_FEED_PLAN_NAME_2=贴贴罐
ARG VITE_FEED_PLAN_NAME_3=饱饱桶
ARG VITE_ALIPAY_QR_URL=
ARG VITE_API_BASE_URL=

ENV VITE_BRAND_NAME=$VITE_BRAND_NAME \
    VITE_DOCS_URL=$VITE_DOCS_URL \
    VITE_SUPPORT_EMAIL=$VITE_SUPPORT_EMAIL \
    VITE_MIN_TOPUP_YUAN=$VITE_MIN_TOPUP_YUAN \
    VITE_FEED_PLAN_YUAN_1=$VITE_FEED_PLAN_YUAN_1 \
    VITE_FEED_PLAN_YUAN_2=$VITE_FEED_PLAN_YUAN_2 \
    VITE_FEED_PLAN_YUAN_3=$VITE_FEED_PLAN_YUAN_3 \
    VITE_FEED_PLAN_NAME_1=$VITE_FEED_PLAN_NAME_1 \
    VITE_FEED_PLAN_NAME_2=$VITE_FEED_PLAN_NAME_2 \
    VITE_FEED_PLAN_NAME_3=$VITE_FEED_PLAN_NAME_3 \
    VITE_ALIPAY_QR_URL=$VITE_ALIPAY_QR_URL \
    VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN pnpm build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
