# Default vhost: refuse unknown Host headers (apex / other domains on same IP).
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${FISH_SITE_HOST} ${FISH_EXTRA_SERVER_NAMES};

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 16m;

    # Docker embedded DNS: re-resolve fish-api after container recreate (avoids stale IP 502).
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $fish_api_upstream fish-api:8800;

    location = /health {
        proxy_pass http://$fish_api_upstream/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location /api/ {
        proxy_pass http://$fish_api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
