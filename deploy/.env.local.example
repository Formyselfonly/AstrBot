# Local Docker smoke test (same compose.prod.yml as production).
#   cp deploy/.env.local.example deploy/.env
#   ./scripts/docker-prod-up.sh
#
# Open http://127.0.0.1:8080 (customer site) and http://127.0.0.1:6185 (engine UI).

