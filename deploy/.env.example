# Copy to deploy/.env and edit before: docker compose --env-file deploy/.env -f compose.prod.yml up -d --build

# --- Compose / public site ---
# Browser URL (no trailing slash); used for CORS
FISH_PUBLIC_URL=https://fish.example.com
# Hostname only (no scheme). Nginx refuses other Host headers (e.g. apex).
FISH_SITE_HOST=fish.example.com
# Optional extra names for local smoke test: 127.0.0.1 localhost
FISH_EXTRA_SERVER_NAMES=
# Bind Docker web on loopback + high port; host Caddy/Nginx routes fish subdomain here.
FISH_BIND_ADDRESS=127.0.0.1
FISH_HTTP_PORT=8080
FISH_CORS_ORIGINS=https://fish.example.com

# --- Ops console (compose --profile console-proxy); expose via Cloudflare Tunnel ---
# Browser basic-auth before AstrBot login; set strong password in production.
CONSOLE_PROXY_USER=kerryzheng
CONSOLE_PROXY_PASSWORD=change-me-console-gate
CONSOLE_PROXY_PORT=6186

# --- fish-api (FISH_ prefix) ---
FISH_ENV=production
FISH_JWT_SECRET=replace-with-long-random-string
FISH_JWT_EXPIRE_MINUTES=10080
FISH_TOPUP_CREDIT_RATIO=0.5
FISH_MIN_TOPUP_YUAN=1
FISH_FEED_PLAN_YUAN_1=2
FISH_FEED_PLAN_YUAN_2=5
FISH_FEED_PLAN_YUAN_3=20
FISH_FEED_PLAN_NAME_1=唔饿啦
FISH_FEED_PLAN_NAME_2=贴贴罐
FISH_FEED_PLAN_NAME_3=饱饱桶
FISH_RICE_GRAMS_PER_YUAN=500
FISH_USAGE_DISPLAY_MULTIPLIER=1
FISH_USD_CNY_RATE=7.2
# After first boot: create OpenAPI key in AstrBot UI (localhost:6185) then paste here
FISH_ASTRBOT_API_KEY=
# QQ Open Platform IP whitelist (server public IPv4)
FISH_QQ_EGRESS_IP=
FISH_ALIPAY_QR_URL=
FISH_ALIPAY_PAY_HINT=转账金额须与本次添饭一致，备注请原样填写下方备注码。
FISH_ADMIN_EMAILS=you@example.com
FISH_ADMIN_API_KEY=
FISH_AUTO_CONFIRM_ORDERS=false

# --- fish-console build args (rebuild web image after changes) ---
VITE_BRAND_NAME=大肥鱼鱼咖
VITE_DOCS_URL=
VITE_SUPPORT_EMAIL=support@example.com
VITE_MIN_TOPUP_YUAN=1
VITE_FEED_PLAN_YUAN_1=2
VITE_FEED_PLAN_YUAN_2=5
VITE_FEED_PLAN_YUAN_3=10
VITE_FEED_PLAN_NAME_1=唔饿啦
VITE_FEED_PLAN_NAME_2=贴贴罐
VITE_FEED_PLAN_NAME_3=饱饱桶
# Leave empty: same-origin /api via nginx in the web container
VITE_API_BASE_URL=
# e.g. /alipay-qr.png if file is in fish-console/public/
VITE_ALIPAY_QR_URL=
